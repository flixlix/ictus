{
  "name": "ictus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flixlix/ictus.git"
  },
  "homepage": "https://ictus.luca-felix.com",
  "version": "1.0.0",
  "description": "Date and time input mask for a plain text field. Formats dd/mm/yyyy, mm/dd/yyyy, yyyy-mm-dd, or HH:mm as you type. Headless, 2.6 kB, optional React hook.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "import": "./dist/time.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docs/tsconfig.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "docs": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "measure": "pnpm build && node scripts/measure.mjs",
    "changeset": "changeset",
    "release": "changeset publish",
    "demo:gif": "node scripts/demo-gif.mjs"
  },
  "keywords": [
    "date",
    "time",
    "date-input",
    "date-mask",
    "date-input-mask",
    "time-input",
    "time-mask",
    "input-mask",
    "inputmask",
    "masked-input",
    "mask",
    "as-you-type",
    "dd/mm/yyyy",
    "mm/dd/yyyy",
    "dd-mm-yyyy",
    "yyyy-mm-dd",
    "ddmmyyyy",
    "caret",
    "headless",
    "hh-mm",
    "hh:mm",
    "react",
    "react-hook",
    "typescript",
    "vanilla",
    "form",
    "text-field",
    "format"
  ],
  "author": "flixlix",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
