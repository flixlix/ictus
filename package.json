{
  "name": "ictus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flixlix/ictus.git"
  },
  "homepage": "https://github.com/flixlix/ictus",
  "version": "0.1.1",
  "description": "Headless as-you-type mask for a single day-month-year input",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docs/tsconfig.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "docs": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts",
    "measure": "pnpm build && node scripts/measure.mjs",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "keywords": [
    "date",
    "input",
    "mask",
    "caret",
    "headless",
    "dd-mm-yyyy"
  ],
  "author": "flixlix",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
